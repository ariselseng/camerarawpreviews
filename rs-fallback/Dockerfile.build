# syntax=docker/dockerfile:1
#
# Build-only image: produces a portable glibc binary, not a runtime image.
# We build on Debian bullseye (glibc 2.31, ~2020) so the resulting binary runs
# on practically every still-supported Linux distro — glibc is backwards
# compatible, so a binary built against an OLD glibc runs on NEWER ones.
#
# This container is a build sandbox only. Extract the binary with build.sh; the
# Nextcloud app downloads and runs it as a CLI — no Docker is needed at runtime.

FROM rust:1-bullseye AS build

# LibRaw version compiled into the binary. raw_preview_rs's build.rs pins an
# old release, so the patch below rewrites it to this value. Keep in sync with
# `libraw_version` in the Makefile.
ARG LIBRAW_VERSION=0.22.3

# Bullseye is EOL and its security pool has been purged, so the stale
# bullseye-security index 404s on package downloads. The build only needs a C++
# toolchain and cmake: raw_preview_rs downloads and statically links LibRaw,
# zlib and libjpeg-turbo itself, so libraw-dev is not needed.
RUN sed -i '/bullseye-security/d' /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        cmake \
        g++ \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Work around two macOS-isms hardcoded in raw_preview_rs 0.1.2's build.rs:
#   1. It passes -DCMAKE_OSX_ARCHITECTURES=arm64 to the vendored libjpeg-turbo;
#      libjpeg-turbo's CMakeLists honours that to pick CPU_TYPE even on Linux,
#      so on x86_64 it builds the ARM NEON SIMD path and fails on arm_neon.h.
#      Shim cmake to append -DWITH_SIMD=0 (last value wins), disabling
#      libjpeg-turbo's hand-written SIMD entirely.
#   2. It emits `-lc++` (LLVM C++ runtime) for the C++ objects it compiles with
#      g++, whose runtime is libstdc++. Point `-lc++` at libstdc++ so names
#      resolve and the g++ ABI matches.
RUN printf '#!/bin/sh\nexec /usr/bin/cmake "$@" -DWITH_SIMD=0\n' > /usr/local/bin/cmake \
    && chmod +x /usr/local/bin/cmake \
    && ln -s libstdc++.so.6 /usr/lib/$(uname -m)-linux-gnu/libc++.so

WORKDIR /src

COPY Cargo.toml Cargo.lock* ./
RUN mkdir src && echo 'fn main() {}' > src/main.rs \
    && cargo build --release \
    && rm -rf src

# Patch raw_preview_rs's libraw wrapper and build script in place:
#   1. The upstream crate hardcodes `no_auto_bright = 1`, which disables
#      libraw's auto-brightness and makes the developed preview come out dark.
#      Set it to 0 so the result is tonally closer to the camera's JPEG.
#   2. Its build.rs pins LibRaw 0.21.4, which is two releases behind and lacks
#      the parser hardening in 0.22.x. Point it at LIBRAW_VERSION.
# The crate source is already extracted into the registry by the dependency
# pre-build above; we edit it there and `cargo clean` that one package so the
# final build recompiles the wrapper and downloads the newer LibRaw.
RUN set -eu; \
    wrapper="$(find /usr/local/cargo/registry/src -type f -name 'libraw_wrapper.cpp' -path '*raw_preview_rs-*' | head -1)"; \
    test -n "$wrapper"; \
    sed -i 's/no_auto_bright = 1;/no_auto_bright = 0;/g' "$wrapper"; \
    echo "patched wrapper:"; grep -n 'no_auto_bright' "$wrapper"; \
    build_script="$(find /usr/local/cargo/registry/src -type f -name 'build.rs' -path '*raw_preview_rs-*' | head -1)"; \
    test -n "$build_script"; \
    sed -i "s/0\.21\.4/${LIBRAW_VERSION}/g" "$build_script"; \
    echo "patched build.rs:"; grep -n "${LIBRAW_VERSION}" "$build_script" | head -5; \
    cargo clean --release -p raw_preview_rs

COPY src ./src
RUN touch src/main.rs && cargo build --release \
    && strip target/release/camerarawpreviews
